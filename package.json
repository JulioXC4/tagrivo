{
  "name": "tagrivo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "npm run audit:release && npm run test && npm run build && node scripts/verify-build.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "check:links": "node scripts/check-external-links.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^7.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
