# Confirmed public test origin. Preview branches use their own CF_PAGES_URL.
PUBLIC_SITE_URL=https://tagrivo.pages.dev
# Keep disabled for the public test, in BOTH Production and Preview settings.
SITE_INDEXING=disabled
# Set only after approval to the Amazon Associates program.
PUBLIC_AMAZON_ASSOCIATE_TAG=
# Optional: actual HTML-tag token for the Google Search Console URL-prefix property.
# Set in Production only; this does not remove noindex or enable analytics.
PUBLIC_GOOGLE_SITE_VERIFICATION=
