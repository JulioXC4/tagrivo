---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { printers } from '../../data/printers';
---

<Base
  title="Thermal Label Printer Shortlist: Rollo, MUNBYN & Brother"
  description="Explore three direct thermal shipping label printers: Rollo X1040, MUNBYN ITPP941 USB and Brother QL-1110NWB. Check variants, media and limitations."
>
  <div class="wrap">
    <header class="page-heading">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Printers</span>
      </nav>
      <h1>
        A considered <em>shortlist.</em>
      </h1>
      <p>
        Three direct thermal shipping label printers for different workspaces. Explore exact
        variants, sourced specifications and practical limitations. For buying criteria, read{' '}
        <a href="/guides/choose-label-printer/">how to choose a printer</a>; for a decision between
        models, use the <a href="/guides/rollo-wireless-vs-munbyn-itpp941-usb/">Rollo–MUNBYN</a> or{' '}
        <a href="/guides/rollo-vs-brother/">Rollo–Brother comparison</a>.
      </p>
    </header>
    <div class="product-grid" style="margin-top:0;padding-bottom:50px">
      {printers.map((printer) => (
        <ProductCard printer={printer} />
      ))}
    </div>
    <p class="small-note" style="padding-bottom:35px">
      Research-based selection, not hands-on testing. No paid placement.{' '}
      <a href="/methodology/">Read our methodology.</a>
    </p>
  </div>
</Base>
