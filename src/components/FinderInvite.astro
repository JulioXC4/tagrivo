---
import Icon from './Icon.astro';
---

<form class="finder-compact" action="/printer-finder/" method="get">
  <h3>How do you sell?</h3>
  <fieldset class="choices">
    <legend class="sr-only">Your selling platform</legend>
    {['Etsy', 'Shopify', 'eBay', 'Other'].map((platform) => (
      <label class="option native-option">
        <input type="radio" name="platform" value={platform} required />
        <span>{platform}</span>
      </label>
    ))}
  </fieldset>
  <div class="form-navigation">
    <span class="small-note">A shortlist built around your setup.</span>
    <button class="button" type="submit">
      Start my printer match <Icon name="arrow" size={18} />
    </button>
  </div>
  <p class="privacy-note">No email required. Your platform carries over to the Finder.</p>
</form>
