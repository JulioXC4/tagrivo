---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import {
  printers,
  systemNames,
  getConnectionLabels,
  formatResearchDate,
} from '../../data/printers';
import { amazonLinkFor } from '../../lib/affiliate';
import { amazonAssociateTag } from '../../config/integrations';
import { amazonListings } from '../../data/amazon';
import AmazonCTA from '../../components/AmazonCTA';
export function getStaticPaths() {
  return printers.map((printer) => ({ params: { id: printer.id }, props: { printer } }));
}
const { printer: p } = Astro.props;
const affiliate = amazonLinkFor(p.id, amazonAssociateTag);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  model: p.model,
  brand: { '@type': 'Brand', name: p.brand },
  description: p.description,
  url: new URL(`/printers/${p.id}/`, Astro.site).href,
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Resolution', value: `${p.dpi} dpi` },
    { '@type': 'PropertyValue', name: 'Printing technology', value: 'Direct thermal' },
  ],
};
---

<Base
  title={`${p.name} — Specifications, Compatibility & Trade-offs`}
  description={p.description}
  image={p.image}
  imageAlt={p.imageAlt}
  schema={schema}
>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb" style="padding-top:36px">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/printers/">Printers</a>
      <span aria-hidden="true">/</span>
      <span>{p.name}</span>
    </nav>
    <section class="product-detail">
      <div>
        <div class="detail-photo">
          <img src={p.image} alt={p.imageAlt} width="680" height="680" fetchpriority="high" />
        </div>
        <p class="small-note" style="margin-top:12px">
          AI-generated editorial render based on manufacturer reference imagery. Not an exact
          reproduction; physical details may vary. Specifications are checked separately against
          official sources.
          <br />
          <a class="text-link" href={p.sources[0].url} target="_blank" rel="noopener noreferrer">
            {p.id === 'munbyn-itpp941'
              ? 'View official 941-series photos'
              : `View official ${p.name} photos`}
          </a>
        </p>
      </div>
      <div class="detail-copy">
        <p class="product-fit">{p.fit}</p>
        <h1>{p.name}</h1>
        <p>{p.description}</p>
        <p class="small-note">
          {p.model} · Manufacturer specifications checked {formatResearchDate(p.checked)}.
          <br />
          Research-based analysis. We have not hands-on tested this printer.
        </p>
        <dl class="detail-facts">
          <div>
            <dt>Resolution</dt>
            <dd>{p.dpi} dpi</dd>
          </div>
          <div>
            <dt>Rated maximum speed</dt>
            <dd>{p.speed} mm/s</dd>
          </div>
          <div>
            <dt>Connections</dt>
            <dd>{getConnectionLabels(p).join(' · ')}</dd>
          </div>
          <div>
            <dt>Media</dt>
            <dd>{p.media}</dd>
          </div>
        </dl>
        <div class="hero-actions">
          {affiliate ? (
            <AmazonCTA printerId={p.id} prominent />
          ) : (
            <a
              href={p.sources[0].url}
              class="button"
              target="_blank"
              rel="noopener noreferrer"
              data-link-kind="manufacturer"
              data-printer-id={p.id}
            >
              Visit the manufacturer <Icon name="external" size={18} />
            </a>
          )}
          <a
            href={`/compare/?printers=${p.id},${p.id === 'rollo-wireless' ? 'munbyn-itpp941' : 'rollo-wireless'}`}
            class="text-link"
          >
            Compare this printer <Icon name="arrow" size={17} />
          </a>
        </div>
        <p class="small-note" style="margin-top:20px">
          {p.priceNote}
        </p>
        {affiliate && (
          <p class="small-note">
            Amazon listing: {amazonListings[p.id].variant}. Confirm the selected model and offer at
            Amazon.
            <br />
            As an Amazon Associate I earn from qualifying purchases.{' '}
            <a href="/affiliate-disclosure/">About affiliate links</a>.
          </p>
        )}
      </div>
    </section>
    <section class="detail-sections">
      <div>
        <h2>Why consider it</h2>
        <ul>
          {p.strengths.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Know the limitations</h2>
        <ul>
          {p.limitations.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>
    <section class="detail-sections">
      <div>
        <h2>Your setup, checked.</h2>
        <p style="color:var(--muted);font-size:14px">{p.setup}</p>
        <p class="small-note">
          Documented workflows: {p.systems.map((s) => systemNames[s]).join(', ')}. Support depends
          on your exact OS version and application. For Etsy, Shopify, and eBay, use a 4 × 6 PDF
          label and confirm scaling in the print dialog.
        </p>
        <a class="text-link" href="/printer-finder/">
          Check your own setup <Icon name="arrow" size={18} />
        </a>
      </div>
      <div>
        <h2>Read the evidence</h2>
        <ol class="source-list">
          {p.sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.label} <Icon name="external" size={14} />
              </a>
            </li>
          ))}
        </ol>
        <p class="small-note" style="margin-top:20px">
          Manufacturer ratings describe specified conditions, not our measured performance. Consult
          the linked support pages before buying; model variants and supported OS releases change.
        </p>
      </div>
    </section>
    <section class="section">
      <div class="section-heading">
        <h2>
          What will it cost <em>you?</em>
        </h2>
        <a class="text-link" href="/cost-calculator/">
          Open the cost calculator <Icon name="arrow" size={18} />
        </a>
      </div>
      <p class="section-intro">
        Enter your hardware quote and the price of compatible label stock. DK rolls and generic
        fanfold stock should be compared by cost per usable shipping label.
      </p>
    </section>
  </div>
</Base>
