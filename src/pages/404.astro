---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Page Not Found"
  description="This Tagrivo page could not be found. Return to the printer finder, comparisons and practical shipping-label guides."
  noindex
>
  <div class="error-page wrap">
    <p class="product-fit">404 · A small detour</p>
    <h1>
      This label
      <br />
      <em>lost its way.</em>
    </h1>
    <p>The page you’re looking for may have moved. Let’s get you back to a clearer decision.</p>
    <div class="hero-actions">
      <a class="button" href="/">
        Back to Tagrivo <Icon name="arrow" />
      </a>
      <a class="text-link" href="/printer-finder/">
        Find a printer <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</Base>
