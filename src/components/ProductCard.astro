---
import { printers, getConnectionLabels, type Printer } from '../data/printers';
import Icon from './Icon.astro';
interface Props {
  printer: Printer;
}
const { printer: p } = Astro.props;
const alternative = printers.find((printer) => printer.id !== p.id)!;
---

<article class="product-card">
  <a
    href={`/printers/${p.id}/`}
    class="product-image"
    data-model={p.id}
    aria-label={`Explore ${p.name}`}
  >
    <img
      src={p.image}
      alt={`${p.name} ${p.model}, manufacturer product photograph`}
      width="600"
      height="600"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="product-copy">
    <p class="product-fit">{p.fit}</p>
    <h3>
      <a href={`/printers/${p.id}/`}>{p.name}</a>
    </h3>
    <p class="product-description">{p.description}</p>
    <dl class="mini-specs">
      <div>
        <dt>Resolution</dt>
        <dd>{p.dpi} dpi</dd>
      </div>
      <div>
        <dt>Connection</dt>
        <dd>{getConnectionLabels(p).join(' · ')}</dd>
      </div>
      <div class="media-spec">
        <dt>Label stock</dt>
        <dd>{p.media}</dd>
      </div>
    </dl>
    <div class="product-tradeoffs">
      <p>
        <strong>Why consider it</strong>
        {p.strengths[0]}
      </p>
      <p>
        <strong>Keep in mind</strong>
        {p.limitations[0]}
      </p>
    </div>
    <div class="product-actions">
      <a class="text-link" href={`/printers/${p.id}/`} aria-label={`Read ${p.name} analysis`}>
        Read analysis <Icon name="arrow" size={18} />
      </a>
      <a
        class="text-link"
        href={`/compare/?printers=${p.id},${alternative.id}`}
        aria-label={`Compare ${p.name}`}
      >
        Compare <Icon name="external" size={17} />
      </a>
    </div>
  </div>
</article>
