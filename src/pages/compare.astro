---
import Base from '../layouts/Base.astro';
import Compare from '../components/Compare';
---

<Base
  title="Compare Thermal Label Printers: Specs & Costs"
  description="Compare two or three shipping label printers side by side: connections, media, device caveats and ownership estimates from your own hardware and label quotes."
>
  <div class="wrap">
    <header class="page-heading">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Compare printers</span>
      </nav>
      <h1>
        The details, <em>side by side.</em>
      </h1>
      <p>
        Compare two or three printers by specifications and your own cost assumptions. For the
        purchase reasoning, read{' '}
        <a href="/guides/rollo-wireless-vs-munbyn-itpp941-usb/">Rollo versus MUNBYN USB</a> or{' '}
        <a href="/guides/rollo-vs-brother/">Rollo versus Brother</a>.
      </p>
    </header>
    <div style="padding-bottom:72px">
      <Compare client:load />
      <noscript>
        <p>
          The initial comparison below is readable without JavaScript. Enable JavaScript to change
          printers or filter differences. <a href="/printers/">Browse all product details.</a>
        </p>
      </noscript>
    </div>
  </div>
</Base>
