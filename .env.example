# Confirmed public test origin. Preview branches use their own CF_PAGES_URL.
PUBLIC_SITE_URL=https://tagrivo.pages.dev
# Keep disabled for the public test, in BOTH Production and Preview settings.
SITE_INDEXING=disabled
# Public Store ID supplied by the registered owner. Defaults to tagrivo-20 in source.
# Registration is not a statement of final program approval.
PUBLIC_AMAZON_ASSOCIATE_TAG=tagrivo-20
# Optional: actual HTML-tag token for the Google Search Console URL-prefix property.
# Set in Production only; this does not remove noindex or enable analytics.
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional GA4: enable later with a genuine Measurement ID, approved policy and reader consent.
# No analytics destination has been provided yet; this does not block the SEO launch.
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_ANALYTICS_POLICY_APPROVED=false
PUBLIC_GA4_MEASUREMENT_ID=
# Legal identity is build-only data. Keep real values in ignored .env and Cloudflare Production.
# Never put them in PUBLIC variables, the source catalog, or Git history.
LEGAL_POLICY_APPROVED=false
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_DOCUMENT=
LEGAL_OPERATOR_ADDRESS=
