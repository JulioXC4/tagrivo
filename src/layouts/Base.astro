---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import displayFont from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url';
import bodyFont from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
  ogType?: 'website' | 'article';
}
const {
  title = 'Thermal Label Printer Reviews & Comparisons',
  description = 'Find the right label printer for your small business. Compare features, compatibility and long-term printing costs.',
  image = '/images/editorial-hero.webp',
  noindex = false,
  schema,
  ogType = 'website',
} = Astro.props;
const site = Astro.site!;
const preventIndexing = noindex || !import.meta.env.SITE_INDEXABLE;
const canonical = new URL(Astro.url.pathname, site);
const navigation = [
  ['Printer Finder', '/printer-finder/'],
  ['Compare', '/compare/'],
  ['Buying Guides', '/guides/'],
  ['Cost Calculator', '/cost-calculator/'],
];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tagrivo — {title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#185642" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Tagrivo" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={`Tagrivo — ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`Tagrivo — ${title}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site)} />
    {preventIndexing && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      try {
        const preference = localStorage.getItem('tagrivo-theme');
        document.documentElement.dataset.theme =
          preference || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        schema || {
          '@context': 'https://schema.org',
          '@type': Astro.url.pathname === '/' ? 'WebSite' : 'WebPage',
          '@id': Astro.url.pathname === '/' ? new URL('#website', site).href : canonical.href,
          name: Astro.url.pathname === '/' ? 'Tagrivo' : title,
          url: canonical.href,
          description,
          inLanguage: 'en-US',
        },
      ).replace(/</g, '\u003c')}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <header class="site-header wrap">
      <a href="/" class="wordmark" aria-label="Tagrivo home">
        tagrivo
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M3 3h18v18h-8v-9H3z" fill="currentColor" />
            <path d="M13 12h8l-8 9z" fill="currentColor" opacity=".45" />
          </svg>
        </span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {navigation.map(([label, href]) => (
          <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>
            {label}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <button class="icon-button theme-toggle" aria-label="Switch to dark theme">
          <span class="light-icon">
            <Icon name="sun" size={23} />
          </span>
          <span class="dark-icon">
            <Icon name="moon" size={23} />
          </span>
        </button>
        <button
          class="icon-button mobile-toggle"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <Icon name="menu" size={25} />
        </button>
      </div>
    </header>
    <nav id="mobile-nav" class="mobile-nav wrap" aria-label="Mobile navigation" hidden>
      {navigation.map(([label, href]) => (
        <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>
          {label}
          <Icon name="arrow" />
        </a>
      ))}
    </nav>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div class="footer-top">
        <a href="/" class="wordmark" aria-label="Tagrivo home">
          tagrivo
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M3 3h18v18h-8v-9H3z" fill="currentColor" />
            </svg>
          </span>
        </a>
        <p>Print smarter. Ship better.</p>
        <a href="/printer-finder/" class="text-link">
          Find your printer <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="footer-bottom">
        <p>
          Independent research. Clearer decisions.
          <br />
          We may earn a commission from qualifying purchases.
          <br />
          <a href="/affiliate-disclosure/">How affiliate links support Tagrivo</a>
        </p>
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/methodology/">Editorial methodology</a>
          <a href="/affiliate-disclosure/">Affiliate disclosure</a>
          <a href="/privacy/">Privacy</a>
        </nav>
      </div>
      <p class="copyright">
        © {new Date().getFullYear()} Tagrivo. Made for small businesses with big plans.
      </p>
    </footer>
    <script>
      const themeButtons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
      function updateThemeLabels() {
        themeButtons.forEach((button) =>
          button.setAttribute(
            'aria-label',
            `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`,
          ),
        );
      }
      updateThemeLabels();
      themeButtons.forEach((button) =>
        button.addEventListener('click', () => {
          const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          try {
            localStorage.setItem('tagrivo-theme', theme);
          } catch {}
          updateThemeLabels();
        }),
      );
      const toggle = document.querySelector<HTMLButtonElement>('.mobile-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-nav');
      toggle?.addEventListener('click', () => {
        if (!menu) return;
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        menu.hidden = !open;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu && !menu.hidden) {
          menu.hidden = true;
          toggle?.setAttribute('aria-expanded', 'false');
          toggle?.setAttribute('aria-label', 'Open navigation');
          toggle?.focus();
        }
      });
      matchMedia('(min-width: 801px)').addEventListener('change', (event) => {
        if (event.matches && menu && toggle) {
          menu.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open navigation');
        }
      });
    </script>
  </body>
</html>
