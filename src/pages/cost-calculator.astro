---
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator';
---

<Base
  title="Label Printing Cost Calculator: Stock & Waste"
  description="Calculate shipping label printing costs from your hardware quote, label-pack price, order volume and waste. Planning estimates exclude postage and taxes."
>
  <div class="wrap">
    <header class="page-heading">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Printing cost calculator</span>
      </nav>
      <h1>
        Look beyond <em>the price tag.</em>
      </h1>
      <p>
        Estimate label printing costs with your order volume and actual hardware and label quotes.
        Read{' '}
        <a href="/guides/printing-costs/">how the formula treats waste, whole packs and postage</a>,
        then change the assumptions below.
      </p>
    </header>
    <Calculator client:load />
    <noscript>
      <p>
        Enable JavaScript to update the estimate. The{' '}
        <a href="/guides/printing-costs/">printing cost guide</a> explains the formula.
      </p>
    </noscript>
  </div>
</Base>
